# constructorasd.com — local build inputs. Copy to `.env.local` (gitignored) and fill real values.
# The public site needs only these four, per environment. Secrets (service role, Resend) are NOT here —
# they live only in Supabase/Vercel and are used by edge functions (Prompt 3).
#
# The *_DEV / *_PROD suffixes let one file serve both environments. scripts/gen-environment.mjs picks the
# right set from --env. On Vercel you can instead set the un-suffixed KEYs per-environment in the dashboard.

# --- DEV (branch `dev` → Vercel preview; Supabase = sgc-dev) ---
SUPABASE_URL_DEV=https://fzfrnrvndzrjwyvdpkgg.supabase.co
SUPABASE_ANON_KEY_DEV=
SITE_URL_DEV=

# --- PROD (branch `main` → constructorasd.com; Supabase = csd-core prod) ---
# NOTE: SUPABASE_URL_PROD legitimately contains the prod project ref. It only ever lands in the
# GENERATED (gitignored) environment.ts, which verify-sin-ref-hardcodeado.mjs excludes. Never paste the
# prod ref into any other src/ file.
SUPABASE_URL_PROD=
SUPABASE_ANON_KEY_PROD=
SITE_URL_PROD=https://constructorasd.com
