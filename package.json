{
  "name": "constructorasd",
  "version": "2.0.11",
  "description": "Corporate website of Constructora Scheker & Domínguez (CSD)",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/gen-environment.mjs --env dev",
    "start": "ng serve",
    "prebuild": "node scripts/gen-environment.mjs && node scripts/gen-content.mjs && node scripts/gen-version.mjs && node scripts/optimize-images.mjs && node scripts/verify-sin-ref-hardcodeado.mjs && node scripts/verify-tokens.mjs && node scripts/verify-no-ai-tropes.mjs && node scripts/verify-contrast.mjs && node scripts/verify-i18n.mjs && node scripts/verify-images.mjs && node scripts/verify-editable-coverage.mjs",
    "build": "ng build",
    "qa:clean": "node scripts/qa/cleanup-dev.mjs --env dev",
    "psi": "node scripts/qa/psi.mjs",
    "qa:security": "node scripts/qa/verify-security.mjs --env dev",
    "db:diff": "node scripts/supabase/diff.mjs",
    "postbuild": "node scripts/gen-sitemap.mjs && node scripts/gen-redirects.mjs",
    "build:dev": "node scripts/build-env.mjs --env dev",
    "build:prod": "node scripts/build-env.mjs --env prod",
    "env:dev": "node scripts/gen-environment.mjs --env dev",
    "env:prod": "node scripts/gen-environment.mjs --env prod",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/gen-environment.mjs --env dev",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "test:e2e": "playwright test",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/gen-og.mjs",
    "extract:pptx": "node scripts/extract-pptx-media.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "serve:ssr:constructorasd": "node dist/constructorasd/server/server.mjs",
    "upscale": "node scripts/upscale-images.mjs --min-width 1600"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.16",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dompurify": "^3.4.16",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.16",
    "@angular/cli": "^21.2.16",
    "@angular/compiler-cli": "^21.2.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "adm-zip": "^0.6.1",
    "jsdom": "^28.0.0",
    "potrace": "^2.1.8",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
